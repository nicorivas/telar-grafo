#!/usr/bin/env python3
"""El módulo grafo de telar: envuelve nucleo/grafo.py (el lector del método de Open Brinca).

Como orden (`telar grafo vecinos RUTA`, `telar grafo todo [REPO]`, `telar grafo revisar [REPO]`), las rutas
son relativas a donde estás. Como consulta (TELAR_CONSULTA=1: los parámetros llegan en JSON por la entrada),
`ruta` y `repo` son relativas a la raíz de telar, y la respuesta es un objeto JSON.

Cada documento es del repositorio más hondo de `[repos]` que lo contiene (TELAR_REPOS); si no hay
ninguno, del repositorio git donde está. Cómo es el grafo de cada repositorio lo dice su `.grafo.toml`
(el núcleo, sus diccionarios locales, qué carpetas recorre); sin él, todo el repositorio con el núcleo de aquí.
"""
import json
import os
import subprocess
import sys
from pathlib import Path

AQUI = Path(__file__).resolve().parent.parent
LECTOR = AQUI / "nucleo" / "grafo.py"


def repos() -> list[dict]:
    try:
        return json.loads(os.environ.get("TELAR_REPOS") or "[]")
    except ValueError:
        return []


def repo_de(ruta: Path) -> tuple[str, Path]:
    """(nombre, carpeta) del repositorio de esa ruta: el más hondo de [repos], o el de git."""
    ruta = ruta.resolve()
    mejor = None
    for r in repos():
        base = Path(r["ruta"]).expanduser().resolve()
        if (ruta == base or base in ruta.parents) and (mejor is None or len(base.parts) > len(mejor[1].parts)):
            mejor = (r["nombre"], base)
    if mejor:
        return mejor
    carpeta = ruta if ruta.is_dir() else ruta.parent
    git = subprocess.run(["git", "-C", str(carpeta), "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    base = Path(git.stdout.strip()) if git.returncode == 0 else carpeta
    return base.name, base.resolve()


def lector(repo: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run([sys.executable, str(LECTOR), "--repo", str(repo), *args], capture_output=True, text=True,
                          cwd=repo)


def absolutas(datos: dict, base: Path) -> dict:
    """Junto a cada ruta relativa al repositorio, la absoluta: la página la abre sin saber de repos."""
    def fijar(a: dict) -> dict:
        a = dict(a)
        for campo in ("origen", "destino", "ruta"):
            if a.get(campo) and a.get("estado", "ok") != "externo":
                a[f"{campo}_abs"] = str(base / a[campo])
        return a

    for clave in ("salientes", "entrantes", "aristas", "nodos"):
        if isinstance(datos.get(clave), list):
            datos[clave] = [fijar(a) for a in datos[clave]]
    if isinstance(datos.get("nodo"), dict):
        datos["nodo"] = fijar(datos["nodo"])
    return datos


def fallar(texto: str, codigo: int = 1) -> int:
    print(texto, file=sys.stderr)
    return codigo


def main(argv: list[str]) -> int:
    if not argv or argv[0] not in ("vecinos", "todo", "revisar"):
        return fallar("uso: grafo vecinos RUTA | todo [REPO] | revisar [REPO]", 2)
    verbo = argv[0]
    consulta = bool(os.environ.get("TELAR_CONSULTA"))
    if consulta:
        params = json.load(sys.stdin)
        base = Path(os.environ.get("TELAR_RAIZ") or ".").expanduser()
        valor = str(params.get("ruta") or params.get("repo") or "")
    else:
        base = Path.cwd()
        valor = argv[1] if len(argv) > 1 else ""
    if verbo == "vecinos" and not valor:
        return fallar("¿de qué documento? grafo vecinos RUTA", 2)
    ruta = Path(valor).expanduser() if valor else base
    ruta = ruta if ruta.is_absolute() else base / ruta
    if not ruta.exists():
        return fallar(f"no existe: {valor}", 2)
    nombre, repo = repo_de(ruta)

    if verbo == "revisar":
        r = lector(repo, "--check")
        sys.stdout.write(r.stdout)
        sys.stderr.write(r.stderr)
        return r.returncode
    args = ["vecinos", str(ruta.resolve())] if verbo == "vecinos" else []
    if consulta or verbo == "todo":
        args.append("--json")
    r = lector(repo, *args)
    if r.returncode != 0:
        return fallar((r.stderr or r.stdout).strip() or "el lector del grafo falló", r.returncode)
    if not consulta and verbo == "vecinos":
        sys.stdout.write(r.stdout)
        return 0
    datos = absolutas(json.loads(r.stdout), repo)
    datos["repo"] = {"nombre": nombre, "ruta": str(repo)}
    print(json.dumps(datos, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
